{
  "name": "@clidey/ux",
  "private": false,
  "version": "1.5.2",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    },
    "./brand.css": {
      "default": "./dist/brand.css"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "lint": "oxlint",
    "fmt": "oxfmt --write src/",
    "docker:push": "docker buildx build --platform linux/amd64,linux/arm64 -t clidey/ux-dashboard:latest -f k8s/Dockerfile . --push",
    "preview": "vite preview",
    "test": "vitest --coverage",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.3.0",
    "@radix-ui/react-alert-dialog": "1.2.0",
    "@radix-ui/react-checkbox": "1.4.0",
    "@radix-ui/react-context-menu": "2.4.0",
    "@radix-ui/react-dialog": "1.3.0",
    "@radix-ui/react-dropdown-menu": "2.2.0",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.0",
    "@radix-ui/react-progress": "1.2.0",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.0",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.0",
    "@radix-ui/react-tabs": "1.2.0",
    "@radix-ui/react-tooltip": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.55.0",
    "maplibre-gl": "6.14.0",
    "react-map-gl": "8.1.3",
    "react-resizable-panels": "4.14.4",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "happy-dom": "20.14.5",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-dts": "5.1.2",
    "vitest": "4.1.10"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "tailwindcss",
    "radix-ui"
  ],
  "author": "Clidey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clidey/ux.git"
  },
  "bugs": {
    "url": "https://github.com/clidey/ux/issues"
  },
  "homepage": "https://github.com/clidey/ux#readme",
  "packageManager": "pnpm@11.17.0"
}
